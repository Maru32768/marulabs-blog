{
  "name": "marulabs-blog",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/build-search-index.ts dist",
    "build:fixtures": "BLOG_CONTENT=fixtures astro build && node scripts/build-search-index.ts dist-fixtures",
    "preview": "wrangler dev",
    "typecheck": "astro check && tsc -p worker/tsconfig.json && tsc -p tests/worker/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify:source": "node scripts/verify-source.ts",
    "verify:dist": "node scripts/verify-dist.ts",
    "check": "npm run typecheck && npm run lint && npm test && npm run verify:source && npm run build && npm run verify:dist",
    "test:e2e:docker": "docker run --rm --user $(id -u):$(id -g) -e HOME=/tmp -e PW_CONTAINER=1 -v \"$PWD:/work\" -w /work --network host mcr.microsoft.com/playwright:v1.65.0-noble npx playwright test",
    "test:e2e:update": "npm run test:e2e:docker -- --update-snapshots"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.6",
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/vitest-plugin": "^1.6.0",
    "@cloudflare/workers-types": "^5.20261107.1",
    "@playwright/test": "^1.65.0",
    "@types/hast": "^3.0.5",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "hast-util-to-string": "^3.0.1",
    "pagefind": "^1.6.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^4.1.12",
    "wrangler": "^4.158.0",
    "yaml": "^2.9.1"
  }
}
