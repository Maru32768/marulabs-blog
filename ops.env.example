# Template for ~/.config/marulabs/cloudflare.env (chmod 600). Never put real values here.
CLOUDFLARE_ACCOUNT_ID=
# Terraform token, see "必要な権限と Secrets" in README.md.
CLOUDFLARE_API_TOKEN=
# Deploy token. Only used to register the GitHub secret, can be removed afterwards.
CLOUDFLARE_DEPLOY_TOKEN=
# R2 S3 credentials for the Terraform state.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
