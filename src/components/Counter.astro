---
import SidePanel from "./SidePanel.astro";
---

<SidePanel id="sb-counter" title="アクセスカウンター" class="panel-counter">
  <div class="counter-box">
    <span class="counter" data-counter aria-label="トップページの表示回数">
      -------
    </span>
    <p class="counter-label">トップページの表示回数</p>
    <p class="counter-note">訪問者数ではありません</p>
  </div>
</SidePanel>
