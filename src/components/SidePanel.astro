---
interface Props {
  id: string;
  title: string;
  class?: string;
}

const { id, title, class: className } = Astro.props;
---

<section class:list={["panel", "panel--light", className]} aria-labelledby={id}>
  <h2 id={id} class="tcat panel-title">
    {title}
  </h2>
  <div class="panel-body">
    <slot />
  </div>
  <slot name="foot" />
</section>
